{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Accès natif limité au pointeur Windows et aux applications autorisées",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-open-allowed-app",
    "allow-get-screen-size",
    "allow-move-mouse",
    "allow-set-left-mouse-button",
    "allow-scroll-mouse"
  ]
}
